{
  "schema_version": 1,
  "purpose": "公开气体任务的初始模型筛选与共同维护比较预备配置",
  "selection_scope": "首批fit训练、首批explore选起点；首批adopt及后续批次不参与起点选择",
  "profile_status": "待比较的参考配置，尚未选出强基线",
  "base_config": {
    "execution_mode": "real_model",
    "policy": "plan_feedback_reuse",
    "component_actions": true,
    "active_inspection": true,
    "method_memory": true,
    "adaptive_loop": true,
    "recent_cap": 2048,
    "history_cap": 2048,
    "fit_sampling": "class_coverage",
    "demo_budget_per_batch": 48,
    "max_trials": 4,
    "max_plan_calls": 8,
    "worker_wall_seconds": 120,
    "batch_wall_seconds": 600,
    "run_wall_seconds": 6000,
    "output_reserve_seconds": 15,
    "seed": 17
  },
  "profiles": {
    "linear": {"processor": "standard", "predictor": "linear", "max_iter": 2000},
    "linear_alt": {"processor": "standard", "predictor": "linear", "regularization": 0.1, "max_iter": 2000},
    "forest": {"processor": "none", "predictor": "forest", "trees": 200, "max_depth": 10},
    "forest_unbounded": {"processor": "none", "predictor": "forest", "trees": 200},
    "catboost": {"processor": "none", "predictor": "catboost", "trees": 200, "max_depth": 6, "learning_rate": 0.05},
    "catboost_shallow": {"processor": "none", "predictor": "catboost", "trees": 200, "max_depth": 4, "learning_rate": 0.05}
  },
  "parameter_basis": "覆盖线性、随机森林与提升树三种成熟模型族；迭代和容量为有界开发起点。参数未选优，时间上限是本地预备条件，均非官方资源额度。工程点数只约束尝试范围，实际耗时与资源另行记录。"
}
