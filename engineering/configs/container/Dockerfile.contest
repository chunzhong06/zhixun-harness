FROM python:3.13-slim
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 BASELINE_CPU_THREADS=1 OMP_NUM_THREADS=1 OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1
ENV PYTHONPATH=/app/engineering/src:/app
RUN --mount=type=bind,source=scratch/contest-adaptation-20261115/wheels,target=/wheels python -m pip install --no-cache-dir --no-index --find-links=/wheels numpy==2.5.4 pandas==3.1.1 scipy==1.18.1 scikit-learn==1.7.2 cloudpickle==3.1.2 psutil==7.2.2 torch==2.7.1+cpu
COPY engineering/src ./engineering/src
COPY engineering/cli ./engineering/cli
COPY engineering/configs ./engineering/configs
COPY engineering/__init__.py ./engineering/__init__.py
COPY engineering/configs/container/runtime/baselines ./baselines
ENTRYPOINT ["python","-B","engineering/cli/release/contest_entry.py"]
